---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
const title = 'Contact SalaryData.co.uk';
const description = 'Contact us with salary data questions, corrections or partnership enquiries.';
---
<BaseLayout title={title} description={description}>
  <div class="container" style="max-width:640px">
    <Breadcrumbs items={[{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact/' }]} />
    <h1>Contact</h1>
    <form action="https://api.staticforms.xyz/submit" method="POST">
      <input type="hidden" name="accessKey" value="sf_9e906eb6c00416b9d3354749" />
      <input type="hidden" name="_site" value="salarydata.co.uk" />
      <input type="hidden" name="redirectTo" value="https://salarydata.co.uk/contact/?sent=1" />
      <label>Name<input type="text" name="name" required /></label>
      <label>Email<input type="email" name="email" required /></label>
      <label>Subject<input type="text" name="subject" value="Contact form submission (salarydata.co.uk)" /></label>
      <label>Message<textarea name="message" rows="6" required></textarea></label>
      <button type="submit" class="btn">Send</button>
    </form>
  </div>

<!-- Post-submit confirmation. On a static build Astro.url.searchParams is empty at
     runtime, so the ?sent=1 check has to happen client side or the visitor sees the
     same empty form and assumes the send failed. -->
<script is:inline>
  (function () {
    if (new URLSearchParams(window.location.search).get('sent') !== '1') return;
    var run = function () {
      var forms = document.querySelectorAll('form');
      for (var i = 0; i < forms.length; i++) {
        var f = forms[i];
        // only swap forms that actually post to the form service
        if (!f.querySelector('[name="redirectTo"], [name="redirect"]')) continue;
        var box = document.createElement('div');
        box.setAttribute('role', 'status');
        box.style.cssText = 'border:1px solid currentColor;border-radius:8px;padding:1.25rem 1.5rem;margin:0 0 1.5rem;line-height:1.5';
        box.innerHTML = '<strong>Thanks, your message has been sent.</strong><br>We have received it and will be in touch.';
        f.parentNode.insertBefore(box, f);
        f.hidden = true;
      }
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
  })();
</script>
</BaseLayout>

<style>
  form { display: flex; flex-direction: column; gap: .85rem; margin: 1.5rem 0; }
  label { display: flex; flex-direction: column; gap: .3rem; font-size: .9rem; color: var(--c-muted); }
  input, textarea {
    padding: .65rem .85rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem;
    font-family: inherit; color: var(--c-ink);
  }
  input:focus, textarea:focus { outline: 2px solid var(--c-accent); border-color: var(--c-accent); }
  button { align-self: flex-start; }
</style>
